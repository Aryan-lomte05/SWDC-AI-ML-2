# ============================================================
#  Video Deepfake Detector — Environment Config
# ============================================================

# App
APP_NAME="Video Deepfake Detector"
APP_VERSION="1.0.0"
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Paths (local, no cloud)
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
HEATMAP_DIR=outputs/heatmaps
REPORT_DIR=outputs/reports
MODEL_DIR=models/weights

# Database (SQLite, local)
DATABASE_URL=sqlite+aiosqlite:///./deepfake_detector.db

# GPU
DEVICE=cuda           # cuda | cpu
CUDA_DEVICE=0         # RTX 4060

# Model settings
MOCK_MODE=True        # True = simulated scores, no weights needed yet
                      # False = real inference with loaded model weights

# Security
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Analysis defaults
TARGET_FPS=10
MAX_FRAMES=500
MAX_UPLOAD_MB=500
ANALYSIS_DEPTH=standard   # fast | standard | deep

# Signal weights (must sum to 1.0)
WEIGHT_SPATIAL_XCEPTION=0.25
WEIGHT_SPATIAL_VIT=0.20
WEIGHT_FREQUENCY=0.10
WEIGHT_TEMPORAL_LSTM=0.20
WEIGHT_PHYSIOLOGICAL=0.15
WEIGHT_LIP_SYNC=0.10
